# App configuration
PORT=8080
NODE_ENV=development

# Persistence options: mongo | file | memory
PERSISTENCE=mongo

# MongoDB configuration
MONGO_URI=mongodb://localhost:27017/adoptme
DB_NAME=adoptme

# JWT configuration
JWT_ACCESS_SECRET=access-secret-dev
JWT_REFRESH_SECRET=refresh-secret-dev
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=5
RATE_LIMIT_MAX=30

# CORS configuration
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# Nodemailer configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your appp pass word
EMAIL_FROM=AdoptMe <no-reply@email.com>